<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../CrossEngine/CrossEngine.csproj" />
        <ProjectReference Include="vendor/MapMess/MapMess/MapMess.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="vendor/**"/>
        <Compile Remove="vendor/**" />
    </ItemGroup>

    <Target Name="CopyContent" AfterTargets="AfterBuild">
        <Copy SourceFiles="res/logo.png" DestinationFolder="$(OutDir)" />
    </Target>

</Project>
